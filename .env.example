# Copy this file to .env (for running on your PC). On GitHub, add these as repository secrets instead.

# Phone push via the free ntfy app: pick a long random topic name nobody can guess.
NTFY_TOPIC=uzair-jobs-change-this-to-something-random-8f3k2

# Email (optional). For Gmail, SMTP_PASS must be an App Password, not your normal password:
# Google Account > Security > 2-Step Verification > App passwords
